{
  "name": "gongdo-ai-game",
  "version": "0.4.0",
  "private": true,
  "description": "공도 AI-Game — TRACK 01 바이브코딩 실습환경 (S04 단계)",
  "type": "module",
  "scripts": {
    "dev": "vercel dev --listen 3000",
